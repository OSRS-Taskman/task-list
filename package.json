{
	"scripts": {
		"format:ultracite": "ultracite fix",
		"format:tasks": "bun bin/frac.mts 'tiers/*.json'",
		"format": "bun run format:ultracite && bun run format:tasks",
		"lint:ultracite": "ultracite check",
		"lint:tasks": "bun bin/frac.mts --lint 'tiers/*.json'",
		"lint:schema": "bun bin/validate-schema.mts",
		"lint:uuids": "bun bin/validate-uuids.mts",
		"lint:links": "bun bin/validate-links.mts",
		"lint:node-types": "bun -e \"console.log('lint:node-types: no-op after Bun migration')\"",
		"lint": "bun run lint:ultracite && bun run lint:tasks && bun run lint:schema && bun run lint:uuids && bun run lint:links",
		"gen:types": "bun bin/gen-types.mts",
		"gen:uuids": "bun bin/validate-uuids.mts --generate",
		"gen:list:official": "bun bin/gen-list.mts official easy,medium,hard,elite,master",
		"all": "bun run format && bun run lint && bun run gen:types"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.6",
		"@tsconfig/bun": "^1.0.11",
		"@types/bun": "^1.4.4",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"fastest-levenshtein": "^1.0.16",
		"fracturedjsonjs": "^4.1.1",
		"glob": "^11.1.0",
		"json-schema-to-typescript": "^16.0.0",
		"lefthook": "^1.13.6",
		"radash": "^12.1.1",
		"typescript": "^6.0.3",
		"ultracite": "^5.6.4"
	},
	"packageManager": "bun@1.4.3",
	"trustedDependencies": [
		"lefthook"
	]
}
