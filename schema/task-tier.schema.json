{
	"$id": "task-tier.schema.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"required": ["name", "tasks"],
	"additionalProperties": false,
	"properties": {
		"name": {
			"type": "string",
			"maxLength": 128
		},
		"tasks": {
			"type": "array",
			"items": {
				"$ref": "task.schema.json"
			}
		}
	}
}
