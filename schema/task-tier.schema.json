{
	"$id": "task-tier",
	"$schema": "http://json-schema.org/draft-07/schema",
	"type": "object",
	"required": ["name", "tasks"],
	"additionalProperties": false,
	"properties": {
		"name": {
			"type": "string",
			"maxLength": 128
		},
		"tasks": {
			"type": "array",
			"items": {
				"$ref": "task"
			}
		}
	}
}
